# Voice-Controlled Remote Desktop Agent Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# VAPI Configuration (Voice Assistant)
# =============================================================================
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_assistant_id_here
VAPI_PHONE_NUMBER=+1234567890

# =============================================================================
# External Service API Keys
# =============================================================================
# Groq API key for LLM-powered error analysis
GROQ_API_KEY=your_groq_api_key_here

# Fetch.ai agent address for distributed monitoring
FETCHAI_AGENT_ADDRESS=agent1qxxxxx

# =============================================================================
# Environment Configuration
# =============================================================================
# Options: development, production
ENV=development

# =============================================================================
# Feature Flags
# =============================================================================
# Enable screenshot capture after GUI actions (true/false)
ENABLE_SCREENSHOT_VERIFICATION=true

# Enable Groq-powered error analysis (requires GROQ_API_KEY)
ENABLE_GROQ_ERROR_ANALYSIS=false

# Enable Fetch.ai monitoring (requires FETCHAI_AGENT_ADDRESS)
ENABLE_FETCHAI_MONITORING=false

# =============================================================================
# Timeout Configuration (in seconds)
# =============================================================================
# Maximum time to wait for Agent-S GUI operations
AGENT_S_TIMEOUT_SEC=5

# Maximum time to wait for MCP tool responses
MCP_TIMEOUT_SEC=7

# =============================================================================
# Server Configuration
# =============================================================================
# Host address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
SERVER_HOST=0.0.0.0

# Port number
SERVER_PORT=8000

# Webhook URL for action notifications (leave empty to disable)
WEBHOOK_URL=
